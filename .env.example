# API Credentials (Replace placeholders with your real values)
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
HF_TOKEN="your_huggingface_token_here"

# Cloud-Based Ollama Credentials
OLLAMA_API_KEY="your_ollama_api_key_here"
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_MODEL="gpt-oss:120b-cloud"

# LLM Configuration (Options: groq, gemini, huggingface, ollama)
LLM_PROVIDER="gemini"
GEMINI_MODEL="gemini-2.5-flash"

# API Security Authentication & CORS configuration
API_SECRET_KEY="your_api_secret_key_here"
VITE_API_SECRET_KEY="your_api_secret_key_here"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
VITE_API_URL="http://localhost:8000"

# Application Paths (Optional: Defaults resolved relative to root directory)
# DB_PATH="perfumes.db"
# IMAGES_DIR="Sirvinistyles perfume images"
# OUTPUT_DIR="Ready_To_Post"

# Logging & Cache Configuration
LOG_LEVEL="INFO"
WEATHER_CACHE_TTL="300"

