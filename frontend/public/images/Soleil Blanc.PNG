    <linearGradient id="goldSoleil" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#fff0c2"/><stop offset="50%" stop-color="#d4af37"/><stop offset="100%" stop-color="#fff8db"/></linearGradient>
