<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <radialGradient id="bgBloom" cx="50%" cy="50%" r="60%"><stop offset="0%" stop-color="#3b1d28"/><stop offset="100%" stop-color="#0c0508"/></radialGradient>
    <linearGradient id="pinkBloom" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#ffb6c1"/><stop offset="50%" stop-color="#db7093"/><stop offset="100%" stop-color="#ffe4e1"/></linearGradient>
  </defs>
  <rect width="800" height="1000" fill="url(#bgBloom)"/>
  <ellipse cx="400" cy="860" rx="250" ry="35" fill="#000000" opacity="0.6"/>
  <rect x="270" y="320" width="260" height="460" rx="10" fill="url(#pinkBloom)" opacity="0.8"/>
  <rect x="280" y="330" width="240" height="440" rx="8" fill="#180b11"/>
  <rect x="330" y="240" width="140" height="80" fill="url(#pinkBloom)"/>
  <rect x="300" y="440" width="200" height="200" rx="6" fill="#10060b" stroke="url(#pinkBloom)" stroke-width="2"/>
  <text x="400" y="500" font-family="'Cinzel', serif" font-size="20" font-weight="bold" fill="#ffb6c1" text-anchor="middle" letter-spacing="3">MISS DIOR</text>
  <text x="400" y="540" font-family="'Montserrat', sans-serif" font-size="14" fill="#ffffff" text-anchor="middle" letter-spacing="2">BLOOMING BOUQUET</text>
  <text x="400" y="590" font-family="'Cinzel', serif" font-size="18" fill="#db7093" text-anchor="middle" letter-spacing="4">DIOR</text>
</svg>
