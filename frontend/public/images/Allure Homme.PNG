<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <radialGradient id="bgAllure" cx="50%" cy="50%" r="60%"><stop offset="0%" stop-color="#2a2e33"/><stop offset="100%" stop-color="#0a0c0e"/></radialGradient>
    <linearGradient id="silverAllure" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#ffffff"/><stop offset="50%" stop-color="#a8b0b8"/><stop offset="100%" stop-color="#d8e0e8"/></linearGradient>
  </defs>
  <rect width="800" height="1000" fill="url(#bgAllure)"/>
  <ellipse cx="400" cy="860" rx="250" ry="35" fill="#000000" opacity="0.7"/>
  <rect x="260" y="300" width="280" height="480" rx="15" fill="url(#silverAllure)"/>
  <rect x="270" y="310" width="260" height="460" rx="10" fill="#14181c"/>
  <rect x="330" y="200" width="140" height="100" rx="6" fill="#0a0c0e" stroke="url(#silverAllure)" stroke-width="2"/>
  <text x="400" y="470" font-family="'Montserrat', sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="4">ALLURE</text>
  <text x="400" y="515" font-family="'Montserrat', sans-serif" font-size="16" fill="#a8b0b8" text-anchor="middle" letter-spacing="6">HOMME SPORT</text>
  <text x="400" y="565" font-family="'Montserrat', sans-serif" font-size="20" font-weight="bold" fill="#e53935" text-anchor="middle" letter-spacing="4">CHANEL</text>
</svg>
